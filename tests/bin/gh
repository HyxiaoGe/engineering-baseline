#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "api" || -z "${2:-}" ]]; then
  echo "mock gh 仅支持 gh api <endpoint>" >&2
  exit 2
fi

endpoint="$2"
case_dir="${AUDIT_FIXTURE_DIR:?必须设置 AUDIT_FIXTURE_DIR}"
good_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../fixtures/good" && pwd)"

# 模拟 GitHub 服务端持续不可用：审计器应重试后报 ERROR，而不是降级成漂移。
if [[ -f "${case_dir}/unavailable-endpoint" ]]; then
  while IFS= read -r pattern || [[ -n "${pattern}" ]]; do
    [[ -z "${pattern}" ]] && continue
    if [[ "${endpoint}" == *"${pattern}"* ]]; then
      echo "gh: Internal Server Error (HTTP 500)" >&2
      exit 1
    fi
  done <"${case_dir}/unavailable-endpoint"
fi

fixture_file() {
  local relative_path="$1"
  if [[ -f "${case_dir}/${relative_path}" ]]; then
    printf '%s\n' "${case_dir}/${relative_path}"
  else
    printf '%s\n' "${good_dir}/${relative_path}"
  fi
}

case "${endpoint}" in
  repos/*/actions/workflows*page=2*)
    cat "$(fixture_file workflows-page-2.json)"
    ;;
  repos/*/actions/workflows*)
    if [[ -f "${case_dir}/workflows-page-1.json" ]]; then
      cat "${case_dir}/workflows-page-1.json"
    else
      cat "$(fixture_file workflows.json)"
    fi
    ;;
  repos/*/branches/*/protection*)
    cat "$(fixture_file protection.json)"
    ;;
  repos/*/environments/dev/secrets*page=2*)
    cat "$(fixture_file env-secrets-page-2.json)"
    ;;
  repos/*/environments/dev/secrets*)
    if [[ -f "${case_dir}/env-secrets-page-1.json" ]]; then
      cat "${case_dir}/env-secrets-page-1.json"
    else
      cat "$(fixture_file env-secrets.json)"
    fi
    ;;
  repos/*/environments/dev*)
    if [[ -f "${case_dir}/missing-environment" ]]; then
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
    fi
    cat "$(fixture_file environment.json)"
    ;;
  repos/*/actions/secrets*page=2*)
    cat "$(fixture_file repo-secrets-page-2.json)"
    ;;
  repos/*/actions/secrets*)
    if [[ -f "${case_dir}/repo-secrets-page-1.json" ]]; then
      cat "${case_dir}/repo-secrets-page-1.json"
    else
      cat "$(fixture_file repo-secrets.json)"
    fi
    ;;
  repos/*/git/trees/*)
    cat "$(fixture_file tree.json)"
    ;;
  repos/*/contents/*)
    python3 - "${endpoint}" "${case_dir}" "${good_dir}" <<'PY'
import base64
import json
from pathlib import Path
import sys
from urllib.parse import unquote

endpoint, case_dir, good_dir = sys.argv[1:]
path = unquote(endpoint.split("/contents/", 1)[1].split("?", 1)[0])
relative = Path(path)
candidate = Path(case_dir) / relative
if not candidate.is_file():
    candidate = Path(good_dir) / relative
if not candidate.is_file():
    raise SystemExit(f"fixture 内容不存在: {path}")
raw = candidate.read_text()
mutation_name = {
    ".github/workflows/release.yml": "release-mutations.json",
    ".github/release-safety.yml": "manifest-mutations.json",
}.get(path)
mutation_path = Path(case_dir) / mutation_name if mutation_name else None
if mutation_path is not None and mutation_path.is_file():
    mutations = json.loads(mutation_path.read_text())
    for mutation in mutations:
        if isinstance(mutation, list):
            old, new = mutation
            if raw.count(old) != 1:
                raise SystemExit(f"fixture 变更目标必须唯一: {old!r}")
            raw = raw.replace(old, new)
            continue
        if mutation.get("op") == "replace_all":
            old = mutation["old"]
            new = mutation["new"]
            if old not in raw:
                raise SystemExit(f"fixture 全局变更目标不存在: {old!r}")
            raw = raw.replace(old, new)
            continue
        if mutation.get("op") != "move_block_before":
            raise SystemExit(f"未知 fixture 变更操作: {mutation!r}")
        start_marker = mutation["start"]
        end_marker = mutation["end"]
        before_marker = mutation["before"]
        if raw.count(start_marker) != 1 or raw.count(before_marker) != 1:
            raise SystemExit(f"fixture 块移动标记必须唯一: {mutation!r}")
        start = raw.index(start_marker)
        if end_marker not in raw[start + len(start_marker):]:
            raise SystemExit(f"fixture 块移动结束标记不存在: {mutation!r}")
        end = raw.index(end_marker, start)
        block = raw[start:end]
        raw = raw[:start] + raw[end:]
        before = raw.index(before_marker)
        raw = raw[:before] + block + raw[before:]
content = base64.b64encode(raw.encode()).decode("ascii")
print(json.dumps({"content": content, "encoding": "base64"}))
PY
    ;;
  repos/*)
    cat "$(fixture_file repo.json)"
    ;;
  *)
    echo "未知 mock endpoint: ${endpoint}" >&2
    exit 2
    ;;
esac
